PORT=3000

# Anime47: access token from your own logged-in browser (server-side only).
# Paste tokens without the "Bearer " prefix. Refresh tokens renew access automatically.
ANIME47_ACCESS_TOKEN=
ANIME47_REFRESH_TOKEN=
# Optional for local runs; Docker stores rotated tokens in a persistent volume.
ANIME47_SESSION_FILE=
# Optional Cloudflare Worker relay for video segments.
ANIME47_MEDIA_RELAY_URL=
ANIME47_MEDIA_RELAY_TOKEN=
ANIME47_MEDIA_RELAY_MODE=server

# Set to https://static.anidoki.com/ after DNS and HTTPS are ready.
WEB_ASSET_BASE=/

# Cấu hình PostgreSQL (Chạy Docker trên cổng riêng 5438)
PGHOST=localhost
PGPORT=5438
PGUSER=anidoki_user
PGPASSWORD=anidoki_secure_pass_2026
PGDATABASE=anidoki_db

DATABASE_URL=postgresql://anidoki_user:anidoki_secure_pass_2026@localhost:5438/anidoki_db

# Google OAuth Credentials
GOOGLE_CLIENT_ID=680572592219-jovd5g5n9p9k5r1ok4p81cpu5sr4hiu9.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# Danh sách email Admin (cách nhau bởi dấu phẩy)
ADMIN_EMAILS=admin@anidoki.com

